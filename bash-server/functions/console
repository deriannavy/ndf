# Console
console(){
   COLOR=10
   MSG=""
   case $1 in
      0)
         COLOR=4
         MSG="INFO"
      ;;
      1)
         COLOR=1
         MSG="ERROR"
      ;;
      2)
         COLOR=2
         MSG="WARNING"
      ;;
      3)
         COLOR=5
         MSG="EXECUTION"
      ;;
      4)
         COLOR=2
         MSG="SUCCESS"
      ;;
      *)
         COLOR=0
         MSG="?"
      ;;
   esac

   TAG="⁅ ${fg_bold[COLOR]}$MSG$reset_color ⁆"
   echo -e "\n$TAG › $2\n"
}


# Console
console_line(){
   COLOR=""
   MSG=""
   COUNT=0
   case $1 in
      0)
         COLOR=4
         MSG="INFO"
         COUNT=14
      ;;
      1)
         COLOR=1
         MSG="ERROR"
         COUNT=15
      ;;
      2)
         COLOR=3
         MSG="WARNING"
         COUNT=17
      ;;
      3)
         COLOR=5
         MSG="EXECUTION"
      ;;
      4)
         COLOR=3
         MSG="SUCCESS"
      ;;
      *)
         COLOR=0
         MSG="?"
         COUNT=1
      ;;
   esac

   TAG="⁅ ${fg_bold[COLOR]}$MSG$reset_color ⁆"
   MESSAGE="------------------------------ ‹ $TAG › ------------------------------"
   DASH=$(printf "%-$((COUNT+60))s" "")
   echo -e "\n  $MESSAGE  "
   echo "  »  $2  "
   echo -e "  ${DASH// /-} \n"
}

