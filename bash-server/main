#!/bin/bash


# Colors
reset_color='\033[00m'
fg=(
    '\033[00;30m'
  	 '\033[00;31m'
	 '\033[00;32m'
	 '\033[00;33m'
	 '\033[00;34m'
	 '\033[00;35m'
	 '\033[00;36m'
	 '\033[00;37m'
)
fg_bold=(
    '\033[01;30m' # black
    '\033[01;31m' # red
    '\033[01;32m' # green
    '\033[01;33m' # yellow
    '\033[01;34m' # blue
    '\033[01;35m' # magenta
    '\033[01;36m' # cyan
    '\033[01;37m' # white
)

# Exporting Variables
export VISUAL=vim
export EDITOR="$VISUAL"
export FZF_DEFAULT_OPTS="
   --layout=reverse
   --height=40%
   --prompt='~ '
   --pointer='→'
   --marker='✓'
   --multi
   --cycle
   --preview '([[ -f {} ]] && (bat --style=numbers --color=always {} || cat {})) || ([[ -d {} ]] && (tree -C {} | less)) || echo {} 2> /dev/null | head -200'
   --preview-window=:hidden
   --bind '?:toggle-preview'
"

# Refresh profile
# -----  alias cr="source ~/.bashrc && console 0 Updated..." 
alias cr="source ~/.bashrc" 

# Save git changes and send
pshdot(){
   DT=`date '+%F_%H:%M:%S'`
   cd ~/.ndf/
   git add .
   MESSAGE="Automatic Update $DT" 
   if [ "$#" -eq 1 ]; then 
      MESSAGE="$1"
   fi

   git commit -m $MESSAGE
   git push origin
}

# PS1
project_path(){
   LASTF=${PWD##*/}
   CBRANCH=$(git branch --show-current 2>/dev/null)
   BRANCH="${CBRANCH:+${reset_color} → ${fg_bold[5]}${CBRANCH}}${reset_color}"
   TIME="${fg[3]}$(date +%d.%H.%M)${reset_color}"
   
   if [[ "$PWD" == "$HOME"/Projects/* ]]; then
        PRO=${PWD##*/Projects/} STR=${PRO%%/*}
        echo -e "$TIME $(hostname -s) ‣ [${fg_bold[1]}$STR$BRANCH${reset_color}]$([[ "$LASTF" == "$STR" ]] && echo || echo " $LASTF")"
     else
        echo -e "$TIME $(hostname -s) » ${fg_bold[1]}$LASTF$BRANCH${reset_color}"
   fi
  
}

PS1='$(project_path) \$› '

# Importing Aliases
# ----- ~/.ndf/zsh/functions/*
for i in ~/.ndf/zsh/alias; do source "$i"; done

