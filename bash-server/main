#!/bin/bash


# Colors
reset_color='\033[00m'
# black 0 - red 1 - green 2 - yellow 3 - blue 4 - magenta 5 - cyan 6 - white 
fg=('\033[00;30m' '\033[00;31m' '\033[00;32m' '\033[00;33m' '\033[00;34m' '\033[00;35m' '\033[00;36m' '\033[00;37m')
fg_bold=('\033[01;30m' '\033[01;31m' '\033[01;32m' '\033[01;33m' '\033[01;34m' '\033[01;35m' '\033[01;36m' '\033[01;37m')

# Exporting Variables
export VISUAL=vim
export EDITOR="$VISUAL"
export FZF_DEFAULT_OPTS="
   --layout=reverse
   --height=40%
   --prompt='~ '
   --pointer='→'
   --marker='✓'
   --multi
   --cycle
   --preview '([[ -f {} ]] && (bat --style=numbers --color=always {} || cat {})) || ([[ -d {} ]] && (tree -C {} | less)) || echo {} 2> /dev/null | head -200'
   --preview-window=:hidden
   --bind '?:toggle-preview'
"

# Refresh profile
alias cr="source ~/.bashrc && console 0 Updated..." 

# Save git changes and send
pshdot(){
   DT=`date '+%F_%H:%M:%S'`
   cd ~/.ndf/
   git add .
   MESSAGE="Automatic Update $DT" 
   if [ "$#" -eq 1 ]; then 
      MESSAGE="$1"
   fi

   git commit -m $MESSAGE
   git push origin
}

# PS1
project_path(){
   LASTF=${PWD##*/}
   CBRANCH=$(git branch --show-current 2>/dev/null)
   BRANCH="${CBRANCH:+${reset_color} → ${fg_bold[5]}${CBRANCH}}${reset_color}"
   TIME="${fg[2]}$(date +%d.%H.%M)${reset_color}"
   HOSTUSER="$(whoami):${fg_bold[0]}$(hostname -s)${reset_color}"
   if [[ "$PWD" == "$HOME"/Projects/* ]]; then
        PRO=${PWD##*/Projects/} STR=${PRO%%/*}
        echo -e "$TIME $HOSTUSER ‣ [${fg_bold[1]}$STR$BRANCH${reset_color}]$([[ "$LASTF" == "$STR" ]] && echo || echo " $LASTF")"
     else
        echo -e "$TIME $HOSTUSER » ${fg_bold[1]}$LASTF$BRANCH${reset_color}"
   fi
  
}

PS1='$(project_path) \$› '

# Importing Aliases
for i in ~/.ndf/bash-server/alias ~/.ndf/bash-server/functions/*; do source "$i"; done

